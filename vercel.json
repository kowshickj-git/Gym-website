{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["bom1"],
  "crons": [
    {
      "path": "/api/cron/expiry",
      "schedule": "30 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/webhooks/razorpay",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
