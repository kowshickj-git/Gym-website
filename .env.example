# =============================================================================
# Iron Core Gym — environment variables
#
# Copy to .env.local for development, and set the same keys in the Vercel
# project settings for production. Never commit a filled-in copy: .env.local
# and .env are both in .gitignore.
#
# Run `node scripts/check-config.mjs` at any point to see what is configured
# and what will silently fall back to a mock.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — Supabase
# Dashboard → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Bypasses Row Level Security — never expose it to the
# browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# REQUIRED — application secrets
# -----------------------------------------------------------------------------

# Pepper for hashing OTP codes and deriving each member's internal Supabase
# credential. Generate with:  openssl rand -base64 48
# Rotating this signs every member out and invalidates outstanding OTPs.
AUTH_SECRET=generate-a-long-random-string

# Shared secret for the daily expiry-reminder cron endpoint. Vercel sends this
# automatically as a Bearer token once the variable exists on the project.
# Generate with:  openssl rand -hex 32
CRON_SECRET=generate-another-random-string

# Used for absolute links inside SMS, WhatsApp and email messages, and for
# canonical URLs and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# OPTIONAL — Razorpay (online payments)
# Without these, the app runs with online checkout disabled: members are told to
# pay at the desk, and staff record it. Everything else works unchanged.
# Dashboard → Settings → API Keys
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# The checkout widget in the browser needs the key id (it is not a secret).
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Dashboard → Settings → Webhooks. Set the webhook URL to
#   https://your-domain.com/api/webhooks/razorpay
# and subscribe to: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# -----------------------------------------------------------------------------
# OPTIONAL — SMS (login codes and expiry reminders)
# Leave as `console` and every message is written to the server log instead of
# being sent. Fine for development and for a demo; not fine for real members.
#
# Values: console | msg91 | twilio
# -----------------------------------------------------------------------------
SMS_PROVIDER=console

# MSG91 — the usual choice for Indian transactional SMS (DLT registered).
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
MSG91_OTP_TEMPLATE_ID=

# Twilio — works everywhere, costs more per message in India.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# -----------------------------------------------------------------------------
# OPTIONAL — WhatsApp (reminders go here first when configured; SMS is the
# fallback). Values: console | cloud | twilio
# -----------------------------------------------------------------------------
WHATSAPP_PROVIDER=console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
TWILIO_WHATSAPP_FROM=

# -----------------------------------------------------------------------------
# OPTIONAL — Email (only used for members who gave an email address).
# Values: console | resend
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Iron Core Fitness <no-reply@yourgym.com>"

# -----------------------------------------------------------------------------
# OPTIONAL — demo mode
#
# Shows the OTP on screen instead of requiring an SMS gateway, so a reviewer can
# sign in as a demo member. It relaxes nothing else. MUST be false for a real
# gym: with it on, anyone who knows a member's number can read their login code.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DEMO_MODE=false
DEMO_MODE=false

# -----------------------------------------------------------------------------
# OPTIONAL — internal member identity domain
#
# Members sign in with a phone number and an OTP. Supabase still needs a
# credential behind the session, so each member is given an internal identity at
# this domain. It is never shown to anyone and never receives mail.
# -----------------------------------------------------------------------------
MEMBER_EMAIL_DOMAIN=members.ironcore.local

# -----------------------------------------------------------------------------
# OPTIONAL — used only by scripts/bootstrap-admin.mjs
# -----------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
